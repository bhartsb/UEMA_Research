+                                                                                    10 * mb, 20 * mb)])
+    got = G.parse_pagefile_ex(raw, base, 4096)
+    assert [g[0] for g in got] == ["C:\\pagefile.sys", "D:\\pagefile.sys"]
+    assert abs(got[0][1] - 56000 / 1024.0) < 1e-9 and abs(got[0][3] - 64000 / 1024.0) < 1e-9
+    import struct
+    one = _reply(base, [("C:\\pagefile.sys", 56000 * mb, 56000 * mb, 64000 * mb)])
+
+    def changed(field, value):                                     # the first entry with one field replaced
+        vals = list(struct.unpack_from(G.PAGEFILE_EX_FORMAT, one, 0))
+        vals[field] = value
+        return struct.pack(G.PAGEFILE_EX_FORMAT, *vals) + one[G.PAGEFILE_EX_BYTES:]
+
+    for why, bad, page in (("unknown page size", one, None),
+                           ("a reply shorter than one entry", one[:G.PAGEFILE_EX_BYTES - 1], 4096),
+                           ("a next offset past the reply", changed(0, 4000), 4096),
+                           ("a next offset that does not advance by an entry", changed(0, 8), 4096),
+                           ("a name pointer before the reply", changed(6, base - 2), 4096),
+                           ("a name running past the reply", changed(4, 400), 4096),
+                           ("an odd name length", changed(4, 33), 4096),
