+    out = []
+    for entry in entries or []:
+        parts = str(entry).split()
+        if len(parts) < 3 or not parts[0][:1].isalpha() or parts[0][1:2] != ":":
+            return None
+        try:
+            initial, largest = float(parts[1]), float(parts[2])
+        except ValueError:
+            return None
+        if initial <= 0 or largest < initial:
