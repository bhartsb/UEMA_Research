+def _reply(base, entries):
+    """Bytes as NtQuerySystemInformation(144) returns them at address `base`: the 40-byte entries, then their names."""
+    import struct
+    heads = len(entries) * G.PAGEFILE_EX_BYTES
+    names = [("\\??\\" + n).encode("utf-16-le") for n, _t, _lo, _hi in entries]
+    out, at = b"", heads
+    for i, (n, total, lo, hi) in enumerate(entries):
+        nxt = G.PAGEFILE_EX_BYTES if i + 1 < len(entries) else 0
+        out += struct.pack(G.PAGEFILE_EX_FORMAT, nxt, total, 0, 0, len(names[i]), len(names[i]), base + at, lo, hi)
+        at += len(names[i])
+    return out + b"".join(names)
+
