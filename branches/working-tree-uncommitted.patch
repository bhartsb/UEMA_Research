+def configured_page_files():
+    """[(path, drive, size at boot GiB, largest size GiB)] from the registry's PagingFiles (the setting Windows reads at
+    startup), or None as page_files()."""
+    try:
+        import winreg
+        key = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE,
+                             r"SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management")
+        entries = winreg.QueryValueEx(key, "PagingFiles")[0]
+    except (ImportError, OSError):
