+def parse_pagefile_ex(raw, base, page_bytes):
+    """[(path, allocated GiB, active minimum GiB, active maximum GiB)] from the bytes NtQuerySystemInformation returned
+    (`raw`, exactly the returned count) at buffer address `base`, or None when the page size is unknown, an entry or its
+    name runs outside the returned bytes, a next-entry offset does not advance by at least one entry, or a name's
+    length is zero or odd. The name is read from `raw`, never through its pointer."""
+    if not page_bytes or page_bytes <= 0 or not raw:
+        return None
+    unit = float(page_bytes) / GIB
+    out, off, seen = [], 0, set()
+    while True:
+        if off in seen or off < 0 or off + PAGEFILE_EX_BYTES > len(raw):
+            return None
+        seen.add(off)
+        nxt, total, _use, _peak, length, _cap, ptr, lo, hi = struct.unpack_from(PAGEFILE_EX_FORMAT, raw, off)
+        start = ptr - base
+        if length == 0 or length % 2 or start < 0 or start + length > len(raw):
+            return None
+        try:
+            name = raw[start:start + length].decode("utf-16-le")
+        except UnicodeDecodeError:
+            return None
+        out.append((name[4:] if name.startswith("\\??\\") else name, total * unit, lo * unit, hi * unit))
+        if nxt == 0:
+            return out
+        if nxt < PAGEFILE_EX_BYTES:
+            return None
+        off += nxt
